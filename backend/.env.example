# StoryPulse AI Backend Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./storypulse.db

# Gnani AI Configuration
# Get your API key from https://platform.gnani.ai/
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_PRISMA_ENDPOINT=/stt/v3
GNANI_TIMBRE_ENDPOINT=/api/v1/tts/inference
GNANI_MOCK_FALLBACK=True

# LLM Dialogue Settings
LLM_PROVIDER=mock_fallback
OPENAI_API_KEY=
GEMINI_API_KEY=
